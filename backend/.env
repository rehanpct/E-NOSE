DATABASE_URL=sqlite:///enose.db
SECRET_KEY=dev_secret_key

# ── MAVLink Telemetry ──────────────────────────────────────────────
# Set TELEMETRY_ENABLED=true to start the MAVLink receiver on boot.
# TELEMETRY_PORT is the COM port where your ground radio is plugged in.
# TELEMETRY_BAUD should match the radio's baud rate (57600 for SiK radios).
TELEMETRY_ENABLED=True
TELEMETRY_PORT=COM9
TELEMETRY_BAUD=57600
