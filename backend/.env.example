SECRET_KEY=super_secret_key
DATABASE_URL=postgresql://enose_user:enose_pass@postgres:5432/enose_db

# ── MAVLink Telemetry ──────────────────────────────────────────────
# Set to "true" to enable the MAVLink receiver on startup.
TELEMETRY_ENABLED=True
# COM port for the ground telemetry radio (e.g. COM3, /dev/ttyUSB0).
TELEMETRY_PORT=COM9
# Baud rate — 57600 is standard for SiK/3DR telemetry radios.
TELEMETRY_BAUD=57600
